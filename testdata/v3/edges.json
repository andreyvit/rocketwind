      "result": ".\\[anchor-name\\:--foo\\] {\n    anchor-name: --foo\n}\n.\\[anchor-scope\\:--foo\\] {\n    anchor-scope: --foo\n}\n.\\[animation-timeline\\:--foo\\] {\n    animation-timeline: --foo\n}\n.\\[color\\:--foo\\] {\n    color: var(--foo)\n}\n.\\[font-palette\\:--foo\\] {\n    font-palette: --foo\n}\n.\\[position-anchor\\:--foo\\] {\n    position-anchor: --foo\n}\n.\\[position-try-options\\:--foo\\] {\n    position-try-options: --foo\n}\n.\\[position-try\\:--foo\\] {\n    position-try: --foo\n}\n.\\[scroll-timeline-name\\:--foo\\] {\n    scroll-timeline-name: --foo\n}\n.\\[scroll-timeline\\:--foo\\] {\n    scroll-timeline: --foo\n}\n.\\[timeline-scope\\:--foo\\] {\n    timeline-scope: --foo\n}\n.\\[view-timeline-name\\:--foo\\] {\n    view-timeline-name: --foo\n}\n.\\[view-timeline\\:--foo\\] {\n    view-timeline: --foo\n}\n  "
