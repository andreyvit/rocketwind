            ],
            "result": {
              "content": "@theme {\n  --color-red-500: red;\n}\n.foo {\n  color: red;\n}",
              "base": "/root/foo",
              "path": ""
            }
          }
        ]
      },
      [
        [
          "text-red-500"
        ]
      ]
    ],
    "result": ".text-red-500 {\n  color: var(--color-red-500, red);\n}\n"
  },
  {
    "test": "resolves `@variant` used as `@custom-variant` inside `@reference`",
    "kind": "compile.build",
    "args": [
      "@reference './foo/bar.css';\n@tailwind utilities;",
      {
        "base": "/root",
        "stylesheets": [
          {
            "args": [
              "./foo/bar.css",
              "/root"
            ],
            "result": {
              "content": "@variant dark {\n  &:where([data-theme='dark'] *) {\n    @slot;\n  }\n}",
              "base": "/root/foo",
              "path": ""
            }
          }
        ]
      },
      [
        [
          "dark:flex"
        ]
      ]
    ],
    "result": ".dark\\:flex:where([data-theme='dark'] *) {\n  display: flex;\n}\n"
  }
