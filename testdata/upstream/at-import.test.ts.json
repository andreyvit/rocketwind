[
  {
    "test": "can resolve relative @imports",
    "kind": "compile.build",
    "args": [
      "@import './foo/bar.css';",
      {
        "base": "/root",
        "stylesheets": [
          {
            "args": [
              "./foo/bar.css",
              "/root"
            ],
            "result": {
              "content": ".foo {\n  color: red;\n}",
              "base": "/root/foo",
              "path": ""
            }
          }
        ]
      },
      [
        []
      ]
    ],
    "result": ".foo {\n  color: red;\n}\n"
  },
  {
    "test": "can recursively resolve relative @imports",
    "kind": "compile.build",
    "args": [
      "@import './foo/bar.css';",
      {
        "base": "/root",
        "stylesheets": [
          {
            "args": [
              "./foo/bar.css",
              "/root"
            ],
            "result": {
              "content": "@import './bar/baz.css';",
              "base": "/root/foo",
              "path": ""
            }
          },
          {
            "args": [
              "./bar/baz.css",
              "/root/foo"
            ],
            "result": {
              "content": ".baz {\n  color: blue;\n}",
              "base": "/root/foo/bar",
              "path": ""
            }
          }
        ]
      },
      [
        []
      ]
    ],
    "result": ".baz {\n  color: blue;\n}\n"
  },
