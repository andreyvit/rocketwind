  {
    "test": "updates the base when loading modules inside nested files",
    "kind": "compile.build",
    "args": [
      "@import './foo/bar.css';\n@config './root-config.js';\n@plugin './root-plugin.js';",
      {
        "base": "/root",
        "stylesheets": [
          {
            "args": [
              "./foo/bar.css",
              "/root"
            ],
            "result": {
              "content": "@config './nested-config.js';\n@plugin './nested-plugin.js';",
              "base": "/root/foo",
              "path": ""
            }
          }
        ],
        "modules": [
          {
            "args": [
              "./nested-config.js",
              "/root/foo",
              "config"
            ],
            "result": {
              "base": "",
              "path": "",
              "module": {
                "$function": "() => {}"
              }
            }
          },
          {
            "args": [
              "./root-config.js",
              "/root",
              "config"
            ],
            "result": {
              "base": "",
              "path": "",
              "module": {
                "$function": "() => {}"
              }
            }
          },
          {
            "args": [
              "./nested-plugin.js",
              "/root/foo",
              "plugin"
            ],
            "result": {
              "base": "",
              "path": "",
              "module": {
                "$function": "() => {}"
              }
            },
            "plugins": [
              []
            ]
          },
          {
            "args": [
              "./root-plugin.js",
              "/root",
              "plugin"
            ],
            "result": {
              "base": "",
              "path": "",
              "module": {
                "$function": "() => {}"
              }
            },
            "plugins": [
              []
            ]
          }
        ]
      },
      [
        []
      ]
    ],
    "result": ""
  },
