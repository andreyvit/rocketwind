[
  {
    "test": "utilities must be prefixed",
    "kind": "compile.build",
    "args": [
      "\n    @theme reference prefix(tw);\n    @tailwind utilities;\n\n    @utility custom {\n      color: red;\n    }\n  ",
      {},
      [
        [
          "tw:underline",
          "tw:hover:line-through",
          "tw:custom",
          "tw:group-hover:flex",
          "tw:peer-hover:flex"
        ]
      ]
    ],
    "result": ".tw\\:custom {\n  color: red;\n}\n.tw\\:underline {\n  text-decoration-line: underline;\n}\n@media (hover: hover) {\n  :is(:where(.tw\\:group):hover .tw\\:group-hover\\:flex) {\n    display: flex;\n  }\n  :is(:where(.tw\\:peer):hover ~ .tw\\:peer-hover\\:flex) {\n    display: flex;\n  }\n  .tw\\:hover\\:line-through:hover {\n    text-decoration-line: line-through;\n  }\n}\n"
  },
  {
    "test": "utilities must be prefixed",
    "kind": "compile.build",
    "args": [
      "\n    @theme reference prefix(tw);\n    @tailwind utilities;\n\n    @utility custom {\n      color: red;\n    }\n  ",
      {},
      [
        [
          "underline",
          "hover:line-through",
          "custom"
        ]
      ]
    ],
    "result": ""
  },
  {
    "test": "utilities used in @apply must be prefixed",
    "kind": "compile.build",
    "args": [
      "\n      @theme reference prefix(tw);\n\n      .my-underline {\n        @apply tw:underline;\n      }\n    ",
      {},
      [
        []
      ]
    ],
    "result": ".my-underline {\n  text-decoration-line: underline;\n}\n"
  },
  {
    "test": "utilities used in @apply must be prefixed",
    "kind": "compile",
    "args": [
      "\n      @theme reference prefix(tw);\n\n      .my-underline {\n        @apply underline;\n      }\n    ",
      {}
    ],
    "error": "Cannot apply unprefixed utility class `underline`. Did you mean `tw:underline`?"
  },
  {
    "test": "CSS variables output by the theme are prefixed",
    "kind": "compile.build",
    "args": [
      "\n        @theme prefix(tw) {\n          --color-red: #f00;\n          --color-green: #0f0;\n          --breakpoint-sm: 640px;\n        }\n\n        @tailwind utilities;\n      ",
      {},
      [
        [
          "tw:text-red"
        ]
      ]
    ],
    "result": ":root, :host {\n  --tw-color-red: #f00;\n}\n.tw\\:text-red {\n  color: var(--tw-color-red);\n}\n"
  },
  {
    "test": "CSS theme functions do not use the prefix",
    "kind": "compile.build",
    "args": [
      "\n        @theme prefix(tw) {\n          --color-red: #f00;\n          --color-green: #0f0;\n          --breakpoint-sm: 640px;\n        }\n\n        @tailwind utilities;\n      ",
      {},
      [
        [
          "tw:[color:theme(--color-red)]",
          "tw:text-[theme(--color-red)]"
        ]
      ]
    ],
    "result": ".tw\\:\\[color\\:theme\\(--color-red\\)\\] {\n  color: #f00;\n}\n.tw\\:text-\\[theme\\(--color-red\\)\\] {\n  color: #f00;\n}\n"
  },
  {
    "test": "CSS theme functions do not use the prefix",
    "kind": "compile.build",
    "args": [
      "\n        @theme reference prefix(tw) {\n          --color-red: #f00;\n          --color-green: #0f0;\n          --breakpoint-sm: 640px;\n        }\n\n        @tailwind utilities;\n      ",
      {},
      [
        [
          "tw:[color:theme(--tw-color-red)]",
          "tw:text-[theme(--tw-color-red)]"
