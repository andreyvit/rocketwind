    "test": "a prefix must be letters only",
    "kind": "compile",
    "args": [
      "\n    @theme reference prefix(__);\n  ",
      {}
    ],
    "error": "The prefix \"__\" is invalid. Prefixes must be lowercase ASCII letters (a-z) only."
