  {
    "test": "JS theme functions do not use the prefix",
    "kind": "compile.build",
    "args": [
      "\n        @theme prefix(tw) {\n          --color-red: #f00;\n          --color-green: #0f0;\n          --breakpoint-sm: 640px;\n        }\n\n        @plugin \"./plugin.js\";\n\n        @tailwind utilities;\n      ",
      {
        "modules": [
          {
            "args": [
              "./plugin.js",
              "",
              "plugin"
            ],
            "result": {
              "path": "",
              "base": "",
              "module": {
                "handler": {
                  "$function": "({ addUtilities, theme }) => {\n\t\t\t\taddUtilities({ \".my-custom\": { color: theme(\"--color-red\") } });\n\t\t\t\t// The theme function does not use the prefix\n\t\t\t\t(0,__vite_ssr_import_0__.expect)(theme(\"--tw-color-red\")).toEqual(undefined);\n\t\t\t}"
                }
              }
            },
            "plugins": [
              [
                {
                  "name": "theme",
                  "args": [
                    "--color-red"
                  ],
                  "result": "#f00"
                },
                {
                  "name": "addUtilities",
                  "args": [
                    {
                      ".my-custom": {
                        "color": "#f00"
                      }
                    }
                  ]
                },
                {
                  "name": "theme",
                  "args": [
                    "--tw-color-red"
                  ]
                }
              ]
            ]
          }
        ]
      },
      [
        [
          "tw:my-custom"
        ]
      ]
    ],
    "result": ".tw\\:my-custom {\n  color: #f00;\n}\n"
  },
