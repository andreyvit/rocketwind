[
  {
    "test": "top level theme keys are replaced",
    "kind": "internal:compat/config/resolve-config:resolve",
    "args": [
      [
        {
          "config": {
            "theme": {
              "colors": {
                "red": "red"
              },
              "fontFamily": {
                "sans": "SF Pro Display"
              }
            }
          },
          "base": "/root",
          "reference": false
        },
        {
          "config": {
            "theme": {
              "colors": {
                "green": "green"
              }
            }
          },
          "base": "/root",
          "reference": false
        },
        {
          "config": {
            "theme": {
              "colors": {
                "blue": "blue"
              }
            }
          },
          "base": "/root",
          "reference": false
        }
      ],
      {
        "theme": [],
        "prefix": null
      }
    ],
    "result": {
      "config": {
        "blocklist": [],
        "future": {},
        "experimental": {},
        "prefix": "",
        "important": false,
        "darkMode": null,
        "theme": {
          "colors": {
            "blue": "blue"
          },
          "fontFamily": {
            "sans": "SF Pro Display"
          }
        },
        "plugins": [],
        "content": {
          "files": []
        }
      },
      "replaced": [
        "colors",
        "fontFamily"
      ]
    }
  },
  {
    "test": "theme can be extended",
