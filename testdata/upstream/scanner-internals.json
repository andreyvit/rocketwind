    "test": "glob::tests::it_should_branch_expandable_folders",
    "roots": 1,
    "states": [
      [
        {
          "kind": "dir",
          "path": "$ROOT0"
        },
        {
          "kind": "dir",
          "path": "$ROOT0/.git"
        },
        {
          "kind": "dir",
          "path": "$ROOT0/projects"
        },
        {
          "content": "",
          "kind": "file",
          "mtime": 1,
          "path": "$ROOT0/projects/bar"
        },
        {
          "content": "",
          "kind": "file",
          "mtime": 2,
          "path": "$ROOT0/projects/foo"
        }
      ]
    ],
    "steps": [
      {
        "args": [
          {
            "base": "$ROOT0/projects",
            "pattern": "foo/*.html"
          },
          {
            "base": "$ROOT0/projects",
            "pattern": "bar/*.html"
          }
        ],
        "method": "optimize_globs",
        "result": [
          {
            "base": "$ROOT0/projects/bar",
            "pattern": "*.html"
          },
          {
            "base": "$ROOT0/projects/foo",
            "pattern": "*.html"
          }
        ],
        "state": 0
      }
    ]
