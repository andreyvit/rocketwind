      }
    ],
    "result": [
      {
        "kind": "at-rule",
        "name": "@keyframes",
        "params": "fade-in",
        "nodes": [
          {
            "kind": "rule",
            "selector": "0%",
            "nodes": [
              {
                "kind": "declaration",
                "property": "opacity",
                "value": "0",
                "important": false
