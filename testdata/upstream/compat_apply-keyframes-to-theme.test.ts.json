    "kind": "internal:compat/apply-keyframes-to-theme:apply",
    "args": [
      [],
      {
        "blocklist": [],
        "future": {},
        "experimental": {},
        "prefix": "",
        "important": false,
        "darkMode": null,
        "theme": {
          "keyframes": {
