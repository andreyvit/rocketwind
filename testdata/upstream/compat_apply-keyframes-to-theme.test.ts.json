              {
                "kind": "declaration",
                "property": "opacity",
                "value": "1",
                "important": false
              }
            ]
          },
          {
            "kind": "rule",
            "selector": "100%",
            "nodes": [
              {
                "kind": "declaration",
                "property": "opacity",
                "value": "0",
                "important": false
              }
            ]
          }
        ]
      }
    ]
